{# -- Component Variables -- #}

{# {{ fn('timber_set_product', post) }} #}

{# -- Component Template -- #}

<article itemscope itemtype="https://schema.org/Product" class="c-tease c-tease--product">

    {# Product Schema Metadata #}
    <meta itemprop="name" content="{{ post.title }}" />
    <meta itemprop="url" content="{{ post.link }}" />
    {% if post.thumbnail %}
        <meta itemprop="image" content="{{ post.thumbnail.src }}" />
    {% endif %}

    {% if post.meta('_wc_review_count') %}
        <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
            <meta itemprop="ratingValue" content="{{ post.meta('_wc_average_rating') }}" />
            <meta itemprop="reviewCount" content="{{ post.meta('_wc_review_count') }}" />
        </div>
    {% endif %}

    {% if post.meta('_price') %}
        <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            <meta itemprop="priceCurrency" content="{{ fn('get_woocommerce_currency') }}" />
            <meta itemprop="price" content="{{ post.meta('_price')|replace({',': ''}) }}" />
            <meta itemprop="url" content="{{ post.link }}" />
            {% set stock_status = post.meta('_stock_status') %}
            <meta itemprop="availability" content="https://schema.org/{% if stock_status == 'instock' %}InStock{% else %}OutOfStock{% endif %}" />
        </div>
    {% endif %}

    {% do action('woocommerce_before_shop_loop_item') %}
    {% do action('woocommerce_before_shop_loop_item_title') %}
    {% do action('woocommerce_shop_loop_item_title') %}
    {% do action('woocommerce_after_shop_loop_item_title') %}
    {% do action('woocommerce_after_shop_loop_item') %}

</article>
